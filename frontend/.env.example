# ============================================================
# Abrazy.ai Frontend — Environment Variables
# ============================================================
# Copy this file to .env.local for local development
# For Vercel production: set these in Vercel Dashboard → Settings → Environment Variables
#
# IMPORTANT: All NEXT_PUBLIC_ vars are baked in at BUILD TIME.
# Changing them after build requires a redeploy.
# ============================================================

# URL of your backend API (Render URL in production)
# Local: http://localhost:8000
# Production: https://abrazy-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Same as API URL — used by OAuth connector helpers
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
