{
  "version": 2,
  "name": "abrazy-frontend",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "@abrazy_api_url",
    "NEXT_PUBLIC_BACKEND_URL": "@abrazy_backend_url"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "@abrazy_api_url",
      "NEXT_PUBLIC_BACKEND_URL": "@abrazy_backend_url"
    }
  }
}
