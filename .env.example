# --- Core Application ---
APP_NAME=Abrazy.ai
ENVIRONMENT=development
DEBUG=false
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Security (Change in production) ---
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database (SQLite local default, or PostgreSQL) ---
DATABASE_URL=sqlite+aiosqlite:///dev.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/abrazy_ai

# --- Redis / Celery (Optional for background workers) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- LLM Providers & Router ---
# Option 1: Groq (Ultra-Fast 300+ Tokens/Sec - Recommended for Realtime Multi-Agent Chats)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Google Gemini (Multimodal & Fast)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option 3: OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Option 4: Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Option 5: Local Ollama (Zero-key local offline option)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- Live Free Tools (No keys required) ---
# DuckDuckGo Live Search: Free & enabled by default
# Pollinations.ai Image Generator: Free & enabled by default
# Jina Reader Web Scraper: Free & enabled by default

# --- OAuth Integrations (Optional) ---
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- User Auth OAuth ---
BACKEND_URL=http://localhost:8000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Billing (Optional) ---
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
